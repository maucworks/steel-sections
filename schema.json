{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "steel-sections family file",
  "type": "object",
  "required": [
    "family",
    "standard",
    "unit",
    "sections"
  ],
  "properties": {
    "family": {
      "type": "string",
      "description": "e.g. IPE, HEA, UNP, L"
    },
    "standard": {
      "type": "string",
      "description": "e.g. EN 10034"
    },
    "unit": {
      "type": "string",
      "const": "mm"
    },
    "source": {
      "type": "string",
      "description": "open table this family was lifted from"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "designation",
          "dims"
        ],
        "properties": {
          "designation": {
            "type": "string",
            "description": "e.g. IPE200"
          },
          "dims": {
            "type": "object",
            "description": "family-specific dims in mm (i-beam: depth, width, web, flange)",
            "minProperties": 1
          },
          "mass_kg_m": {
            "type": "number"
          },
          "area_mm2": {
            "type": "number"
          }
        }
      }
    },
    "shape": {
      "type": "string",
      "description": "outline builder: I (more shapes later)"
    }
  }
}
